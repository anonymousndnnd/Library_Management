// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  AUTHOR
}

model Admin {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  email     String     @unique
  password  String
  role      Role       @default(ADMIN)
  customer  Customer[]
  author    Author[]
  createdAt DateTime   @default(now())
  books     Books[]    @relation("AdminBooks")
}

model Customer {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  username      String
  email         String             @unique
  password      String
  adminId       String             @db.ObjectId
  admin         Admin              @relation(fields: [adminId], references: [id])
  role          Role               @default(CUSTOMER)
  books         Books[]            @relation("CustomerBooks")
  createdAt     DateTime           @default(now())
  issueRequests Bookissuerequest[]
}

model Author {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  email     String   @unique
  password  String
  role      Role     @default(AUTHOR)
  adminId   String   @db.ObjectId
  admin     Admin    @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
  books     Books[]  @relation("AuthorBooks")
}

model Books {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  isPublished   Boolean            @default(false)
  authorId      String             @db.ObjectId
  author        Author             @relation("AuthorBooks", fields: [authorId], references: [id])
  createdAt     DateTime           @default(now())
  adminId       String?            @db.ObjectId
  admin         Admin?             @relation("AdminBooks", fields: [adminId], references: [id])
  status        String?
  issueRequests Bookissuerequest[]
  isIsuued      Boolean            @default(false)
  customerId    String?            @db.ObjectId
  customer      Customer?          @relation("CustomerBooks", fields: [customerId], references: [id])
}

model Bookissuerequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  book        Books    @relation(fields: [bookId], references: [id])
  bookId      String   @db.ObjectId
  customer    Customer @relation(fields: [customerId], references: [id])
  customerId  String   @db.ObjectId
  issueStatus String   @default("pending")
  createdAt   DateTime @default(now())
}
